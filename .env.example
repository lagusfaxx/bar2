# ============================================================================
# BARZUO — variables de entorno
#
# Copia este archivo a .env y completa los valores.
# En Coolify, carga estas mismas claves en "Environment Variables".
# ============================================================================

# --- Base de datos ----------------------------------------------------------
# Cadena de conexión a PostgreSQL.
#   Local:   postgresql://barzuo:barzuo@127.0.0.1:5432/barzuo?schema=public
#   Docker:  postgresql://barzuo:CLAVE@db:5432/barzuo?schema=public
DATABASE_URL="postgresql://barzuo:barzuo@127.0.0.1:5432/barzuo?schema=public"

# Tamaño máximo del pool de conexiones (opcional).
# DATABASE_POOL_MAX="10"


# --- Seguridad --------------------------------------------------------------
# Clave con la que se firman las sesiones del panel y de los socios.
# Mínimo 32 caracteres. Genérala con:  openssl rand -base64 48
# Si la cambias, se cierran todas las sesiones abiertas.
AUTH_SECRET="cambiame-por-una-clave-larga-y-aleatoria-de-al-menos-32-caracteres"


# --- Sitio ------------------------------------------------------------------
# URL pública, sin barra final. Se usa en canonical, Open Graph, sitemap y en
# el QR de la BarzuCard, y define si las cookies de sesión se marcan `secure`.
# Tiene que coincidir exactamente con el dominio configurado en Coolify.
# Sin dominio propio todavía, sirve sslip.io:
#   https://barzuo.203.0.113.45.sslip.io
# Al cambiarla hay que reconstruir la imagen: se inserta en tiempo de build.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Zona horaria del local: define a qué hora se muestran los eventos.
NEXT_PUBLIC_TIME_ZONE="America/Santiago"

# Moneda de la carta y de las entradas (código ISO 4217).
NEXT_PUBLIC_CURRENCY="CLP"


# --- Almacenamiento de imágenes ---------------------------------------------
# Carpeta donde se guardan las imágenes subidas desde el CMS.
# Tiene que ser un volumen persistente: si no, se pierden en cada redeploy.
#   Local:  ./storage/uploads
#   Docker: /app/storage/uploads
UPLOAD_DIR="./storage/uploads"


# --- Primer administrador ---------------------------------------------------
# Los usa el seed y el script `npm run create:admin`.
ADMIN_EMAIL="admin@barzuo.com"
ADMIN_PASSWORD="cambiame"
ADMIN_NAME="Administrador BARZUO"

# Cuenta del equipo de sala (solo accede a la app de verificación BarzuCard).
STAFF_EMAIL="sala@barzuo.com"
STAFF_PASSWORD="cambiame"


# --- POS de sala ------------------------------------------------------------
# Token que comparte el servidor con el agente de impresion del local. Minimo
# 16 caracteres. Sin el, la cola de comandas queda cerrada.
#   openssl rand -base64 32
PRINT_AGENT_TOKEN=""


# --- Karaoke ----------------------------------------------------------------
# Clave de la YouTube Data API v3, para buscar karaokes desde /staff/karaoke.
# Se saca en Google Cloud → APIs y servicios → Credenciales, habilitando
# "YouTube Data API v3". Conviene restringirla por IP del servidor.
#
# Sin ella el karaoke igual funciona, pero solo con las canciones que el local
# ya tenga en su catalogo.
#
# Cuota: 10.000 unidades al dia y cada busqueda cuesta 100 (unas 100 busquedas
# diarias). Por eso cada cancion encolada queda guardada y no se vuelve a
# buscar. Los pedidos de las mesas nunca llaman a la API.
#
# YouTube Premium no se configura aca ni en ningun otro lado: para que la
# pantalla reproduzca sin avisos, el navegador de la TV tiene que tener
# iniciada la sesion de la cuenta Premium del local.
YOUTUBE_API_KEY=""


# --- Cache en el borde (Cloudflare) -----------------------------------------
# Con estas dos, al guardar en el panel se vacía el caché de Cloudflare y el
# cambio se ve al instante. Sin ellas el sitio funciona igual, pero hay que
# esperar a que venza la copia (1 hora) o purgar a mano desde Cloudflare.
#
# El token se crea en Cloudflare → My Profile → API Tokens, con el permiso
# "Zone → Cache Purge → Purge". El Zone ID está en la portada del dominio.
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""


# --- Arranque en Docker -----------------------------------------------------
# Si es "true", el contenedor siembra el contenido de demostración al arrancar.
# Solo actúa sobre una base vacía: si el local ya cargó su contenido, el seed
# no toca nada. Aun así conviene dejarla en "false" una vez cargada la demo.
SEED_ON_START="false"

# SEED_FORCE="true" fuerza el seed aunque la base ya tenga contenido y devuelve
# la portada al contenido de demostración. No la dejes puesta en producción.


# --- Solo para docker compose ----------------------------------------------
# POSTGRES_USER="barzuo"
# POSTGRES_PASSWORD="una-clave-segura"
# POSTGRES_DB="barzuo"
# APP_PORT="3000"
