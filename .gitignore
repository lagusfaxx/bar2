!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Archivos subidos desde el CMS (se guardan en un volumen, no en el repo)
/public/uploads
/storage

# El manual de sala se genera, no se edita a mano
manual-de-sala.pdf
