// BARZUO — Restobar · Web oficial + CMS
// Documentacion del modelo de datos: ver README.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Usuarios del panel (administradores y garzones)
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN // acceso total al CMS
  EDITOR // gestiona contenido, no gestiona usuarios
  STAFF // solo la app de verificacion de BarzuCard
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  redemptions Redemption[] @relation("RedemptionStaff")
  auditLogs   AuditLog[]

  openedSessions TableSession[] @relation("SessionOpenedBy")
  orderItems     OrderItem[]    @relation("OrderItemCreatedBy")
  tickets        OrderTicket[]  @relation("TicketCreatedBy")
  payments       Payment[]      @relation("PaymentCashier")

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Cartelera / Eventos
// ---------------------------------------------------------------------------

enum EventCategory {
  TRIBUTO
  EN_VIVO
  DJ
  KARAOKE
  STANDUP
  FIESTA
  ESPECIAL
}

model Event {
  id       String        @id @default(cuid())
  slug     String        @unique
  title    String
  artist   String?
  category EventCategory @default(EN_VIVO)

  excerpt     String? @db.Text
  description String? @db.Text

  // Afiche vertical (cards / detalle) y portada horizontal opcional (hero)
  posterUrl String?
  coverUrl  String?

  startsAt DateTime // fecha y hora de inicio del show
  doorsAt  DateTime? // apertura de puertas
  endsAt   DateTime?

  // Entrada: gratis o con costo
  isFree     Boolean @default(true)
  priceCents Int? // precio de entrada en centesimos
  ticketUrl  String? // link externo de venta de entradas
  capacity   Int?

  published  Boolean @default(false)
  featured   Boolean @default(false)
  ratingLock Boolean @default(false) // cierra la calificacion del evento

  // SEO por evento
  seoTitle       String?
  seoDescription String? @db.Text
  ogImageUrl     String?

  viewCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gallery GalleryImage[]
  ratings EventRating[]

  @@index([published, startsAt])
  @@index([featured, published])
  @@index([category])
  @@map("events")
}

model EventRating {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  authorName String
  rating     Int // 1..5
  comment    String? @db.Text
  approved   Boolean @default(false)

  // hash de IP + user agent para evitar votos duplicados sin guardar datos personales
  fingerprint String

  createdAt DateTime @default(now())

  @@unique([eventId, fingerprint])
  @@index([eventId, approved])
  @@map("event_ratings")
}

// ---------------------------------------------------------------------------
// Carta / Menu
// ---------------------------------------------------------------------------

model MenuCategory {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text
  imageUrl    String?
  icon        String? // nombre de icono lucide
  position    Int     @default(0)
  active      Boolean @default(true)

  // A donde sale la comanda de esta categoria. Se define una vez por categoria
  // y cada producto puede desviarse (ver MenuProduct.station).
  station Station @default(COCINA)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products MenuProduct[]

  @@index([active, position])
  @@map("menu_categories")
}

model MenuProduct {
  id         String       @id @default(cuid())
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name        String
  slug        String  @unique
  description String? @db.Text
  priceCents  Int
  imageUrl    String?

  available Boolean  @default(true)
  featured  Boolean  @default(false)
  position  Int      @default(0)
  tags      String[] @default([]) // ej: "vegano", "picante", "sin gluten"

  // Estacion propia, para los productos que no siguen a su categoria (un postre
  // helado que arma la barra, un cafe que sale de cocina). Vacio = la categoria.
  station Station?

  // Precio promocional. Es la unica fuente del descuento: la carta de la web y
  // el POS de los garzones leen lo mismo, asi que una promo publicada aparece
  // sola en la comanda sin que nadie la cargue dos veces.
  promoPriceCents Int?
  promoLabel      String? // "Happy hour", "2x1 jueves"
  promoStartsAt   DateTime?
  promoEndsAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@index([categoryId, position])
  @@index([available, featured])
  @@map("menu_products")
}

// ---------------------------------------------------------------------------
// Galeria
// ---------------------------------------------------------------------------

model GalleryImage {
  id      String  @id @default(cuid())
  url     String
  alt     String
  caption String?

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  tag      String? // "ambiente", "shows", "cocina", "publico"
  width    Int?
  height   Int?
  position Int     @default(0)
  featured Boolean @default(false)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
  @@index([eventId])
  @@map("gallery_images")
}

// ---------------------------------------------------------------------------
// Biblioteca de medios (uploads del CMS)
// ---------------------------------------------------------------------------

model Media {
  id           String   @id @default(cuid())
  url          String   @unique
  filename     String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("media")
}

// ---------------------------------------------------------------------------
// BarzuCard — programa de fidelizacion
// ---------------------------------------------------------------------------

enum CardTier {
  CLASICA
  PLATA
  ORO
}

enum CardStatus {
  ACTIVE
  SUSPENDED
}

/// Estado del pago y la entrega de la tarjeta fisica.
enum CardPaymentStatus {
  PENDING // se registro pero todavia no pago
  REPORTED // el socio aviso que transfirio; falta confirmar
  PAID // pago confirmado; puede pasar a retirarla
  DELIVERED // ya retiro la tarjeta fisica en el local
}

model Member {
  id           String    @id @default(cuid())
  email        String    @unique
  fullName     String
  passwordHash String
  phone        String?
  birthDate    DateTime?
  acceptsNews  Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card    BarzuCard?
  ratings EventRating[]

  @@map("members")
}

model BarzuCard {
  id       String @id @default(cuid())
  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Identificador numerico legible (16 digitos) impreso en la tarjeta
  cardNumber String @unique
  // Token opaco que viaja dentro del QR (rotable si la tarjeta se pierde)
  qrToken    String @unique

  tier   CardTier   @default(CLASICA)
  status CardStatus @default(ACTIVE)
  points Int        @default(0)

  issuedAt  DateTime  @default(now())
  printedAt DateTime? // fecha en que se imprimio la tarjeta fisica

  // Pago y entrega de la tarjeta fisica (se abona por transferencia y se retira
  // en el local). Los beneficios digitales funcionan desde el registro.
  paymentStatus    CardPaymentStatus @default(PENDING)
  paymentReference String? // numero de operacion o dato que deja el socio
  reportedAt       DateTime? // cuando el socio aviso la transferencia
  paidAt           DateTime? // cuando el local confirmo el pago
  deliveredAt      DateTime? // cuando el socio retiro la tarjeta

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions Redemption[]
  vouchers    PromotionVoucher[]
  payments    Payment[]

  @@index([status])
  @@index([paymentStatus])
  @@map("barzu_cards")
}

enum PromotionType {
  PERCENT_OFF // % de descuento
  AMOUNT_OFF // monto fijo de descuento
  TWO_FOR_ONE // 2x1
  FREE_ITEM // producto de cortesia
  OTHER
}

model Promotion {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String        @db.Text
  terms       String?       @db.Text
  imageUrl    String?
  type        PromotionType @default(PERCENT_OFF)

  // Valor asociado al tipo: % para PERCENT_OFF, centesimos para AMOUNT_OFF
  value Int @default(0)

  startsAt DateTime  @default(now())
  endsAt   DateTime?

  active   Boolean @default(true)
  position Int     @default(0)

  // Reglas de canje
  minTier           CardTier @default(CLASICA)
  maxPerCard        Int      @default(1) // 0 = ilimitado
  maxTotal          Int      @default(0) // 0 = sin tope global
  redeemedCount     Int      @default(0)
  pointsCost        Int      @default(0) // costo en puntos, 0 = gratuito
  pointsReward      Int      @default(0) // puntos que otorga al canjear
  availableWeekdays Int[]    @default([]) // 0=domingo .. 6=sabado; vacio = todos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions Redemption[]
  vouchers    PromotionVoucher[]

  @@index([active, position])
  @@map("promotions")
}

model Redemption {
  id String @id @default(cuid())

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  cardId String
  card   BarzuCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  staffUserId String?
  staffUser   User?   @relation("RedemptionStaff", fields: [staffUserId], references: [id], onDelete: SetNull)

  // Codigo corto mostrado al cliente como comprobante del canje
  receiptCode String @unique

  note         String?
  pointsSpent  Int     @default(0)
  pointsEarned Int     @default(0)

  redeemedAt DateTime @default(now())

  // Presente cuando el canje nacio de un cupon elegido por el socio
  voucher PromotionVoucher?

  @@index([cardId, redeemedAt])
  @@index([promotionId])
  @@map("redemptions")
}

enum VoucherStatus {
  PENDING // emitido, esperando que el equipo de sala lo valide
  REDEEMED // ya se aplico en el local
  EXPIRED // vencio sin usarse
  CANCELLED // el socio lo dio de baja
}

/**
 * Cupon de un descuento concreto, elegido por el socio desde su BarzuCard.
 * La tarjeta identifica a la persona; el cupon identifica que quiere canjear.
 * Separarlos evita que el equipo de sala tenga que adivinar la promocion: al
 * escanear el QR del cupon ya sabe cual es y solo confirma.
 */
model PromotionVoucher {
  id String @id @default(cuid())

  // Codigo corto y legible, por si hay que dictarlo en la barra
  code  String @unique
  // Token opaco que viaja dentro del QR del descuento
  token String @unique

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  cardId String
  card   BarzuCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  status    VoucherStatus @default(PENDING)
  // Vigencia corta: el cupon se pide estando en el local
  expiresAt DateTime

  redemptionId String?     @unique
  redemption   Redemption? @relation(fields: [redemptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId, status])
  @@index([promotionId])
  @@map("promotion_vouchers")
}

// ---------------------------------------------------------------------------
// Configuracion del sitio
// ---------------------------------------------------------------------------

