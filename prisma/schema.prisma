  // Identidad
  barName    String  @default("BARZUO")
  tagline    String  @default("Restobar · Lounge & Club")
  logoUrl    String?
  logoAltUrl String?
  faviconUrl String?

  // Hero
  heroTitle             String  @default("BARZUO")
  heroSubtitle          String? @db.Text
  heroEyebrow           String? @default("EST. 2024")
  heroImageUrl          String?
  heroVideoUrl          String?
  heroCtaLabel          String? @default("Ver cartelera")
  heroCtaHref           String? @default("/eventos")
  heroCtaSecondaryLabel String? @default("Ver la carta")
  heroCtaSecondaryHref  String? @default("/carta")
  heroVideoPosterUrl    String? // primer fotograma mientras carga el video

  // Portada: cintillo animado (una palabra o frase por linea)
  marqueeText String? @db.Text

  // Portada: titulos de cada bloque. Vacio = se usa el texto por defecto.
  homeEventsEyebrow   String? @default("Cartelera")
  homeEventsTitle     String? @default("Lo que se viene")
  homeEventsLead      String? @db.Text
  homeMenuEyebrow     String? @default("La carta")
  homeMenuTitle       String? @default("Para acompanar la noche")
  homeMenuLead        String? @db.Text
  homeLoyaltyTitle    String? @default("Tu tarjeta de beneficios")
  homeGalleryEyebrow  String? @default("Galeria")
  homeGalleryTitle    String? @default("Noches que quedan")
  homeGalleryLead     String? @db.Text
  homeLocationEyebrow String? @default("Ubicacion")
  homeLocationTitle   String? @default("Te esperamos")

  // Nosotros
  aboutTitle             String? @default("Nuestra historia")
  aboutLead              String? @db.Text
  aboutBody              String? @db.Text
  aboutImageUrl          String?
  aboutSecondaryImageUrl String?

  // Contacto y ubicacion
  address     String  @default("Av. Italia 1348, Providencia")
  addressCity String  @default("Santiago, Chile")
  latitude    Float   @default(-33.4392)
  longitude   Float   @default(-70.6250)
  phone       String?
  whatsapp    String?
  email       String?

  // Textos generales
  reservationsNote String? @db.Text
  footerNote       String? @db.Text

  // SEO global
  seoTitle          String  @default("BARZUO Restobar · Musica en vivo, tributos y cocteleria")
  seoDescription    String  @default("BARZUO Restobar en Santiago. Cartelera de shows en vivo, tributos, DJ y la mejor cocteleria de autor.") @db.Text
  seoImageUrl       String?
  seoKeywords       String?
  googleAnalyticsId String?

  // BarzuCard
  loyaltyEnabled     Boolean @default(true)
  loyaltyTitle       String  @default("BarzuCard")
  loyaltyDescription String? @db.Text
  loyaltyTerms       String? @db.Text

  // Tarjeta fisica: se abona por transferencia y se retira en el local.
