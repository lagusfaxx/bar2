// BARZUO — Restobar · Web oficial + CMS
// Documentacion del modelo de datos: ver README.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Usuarios del panel (administradores y garzones)
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN // acceso total al CMS
  EDITOR // gestiona contenido, no gestiona usuarios
  STAFF // solo la app de verificacion de BarzuCard
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  redemptions Redemption[] @relation("RedemptionStaff")
  auditLogs   AuditLog[]

  openedSessions   TableSession[] @relation("SessionOpenedBy")
  attendedSessions TableSession[] @relation("SessionWaiter")
  orderItems       OrderItem[]    @relation("OrderItemCreatedBy")
  tickets          OrderTicket[]  @relation("TicketCreatedBy")
  closedDays       ClosedDay[]    @relation("ClosedDayCreatedBy")
  payments         Payment[]      @relation("PaymentCashier")
  karaokeEntries   KaraokeEntry[] @relation("KaraokeQueuedBy")
  contactReplies   ContactReply[] @relation("ContactReplyAuthor")

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Cartelera / Eventos
// ---------------------------------------------------------------------------

enum EventCategory {
  TRIBUTO
  EN_VIVO
  DJ
  KARAOKE
  STANDUP
  FIESTA
  ESPECIAL
}

/**
 * Quien puede entrar a un evento, cuando el dia no es igual para todos.
 * Un dia marcado como cerrado (`ClosedDay`) da por privado todo lo que caiga
 * en el, y casi siempre eso es lo correcto. Pero pasa que el mismo dia hay un
 * cumpleaños arrendado y ademas toca la banda de siempre: el cierre es del
 * cumpleaños, no del show. Sin esto no habia forma de decirlo, y la banda
 * quedaba anunciada como "solo invitados".
 * Tambien sirve al reves: un evento privado suelto —una fiesta de empresa que
 * igual se quiere publicar— sin tener que cerrar el dia entero.
 */
enum EventAccess {
  /**
   * Lo que diga el dia: privado si esta cerrado, abierto si no.
   */
  SEGUN_EL_DIA
  /**
   * Abierto al publico aunque ese dia el local este arrendado.
   */
  PUBLICO
  /**
   * Solo invitados, este el dia cerrado o no.
   */
  PRIVADO
}

model Event {
  id       String        @id @default(cuid())
  slug     String        @unique
  title    String
  artist   String?
  category EventCategory @default(EN_VIVO)

  excerpt     String? @db.Text
  description String? @db.Text

  // Afiche vertical (cards / detalle) y portada horizontal opcional (hero)
  posterUrl String?
  coverUrl  String?

  startsAt DateTime // fecha y hora de inicio del show
  doorsAt  DateTime? // apertura de puertas
  endsAt   DateTime?

  // Entrada: gratis o con costo
  isFree     Boolean @default(true)
  priceCents Int? // precio de entrada en centesimos
  ticketUrl  String? // link externo de venta de entradas
  capacity   Int?

  published  Boolean @default(false)
  featured   Boolean @default(false)
  ratingLock Boolean @default(false) // cierra la calificacion del evento

  // Quien entra: por defecto lo hereda del dia (ver EventAccess).
  access EventAccess @default(SEGUN_EL_DIA)

  // SEO por evento
  seoTitle       String?
  seoDescription String? @db.Text
  ogImageUrl     String?

  viewCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gallery GalleryImage[]
  ratings EventRating[]

  @@index([published, startsAt])
  @@index([featured, published])
  @@index([category])
  @@map("events")
}

model EventRating {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  authorName String
  rating     Int // 1..5
  comment    String? @db.Text
  approved   Boolean @default(false)

  // hash de IP + user agent para evitar votos duplicados sin guardar datos personales
  fingerprint String

  createdAt DateTime @default(now())

  @@unique([eventId, fingerprint])
  @@index([eventId, approved])
  @@map("event_ratings")
}

// ---------------------------------------------------------------------------
// Carta / Menu
// ---------------------------------------------------------------------------

model MenuCategory {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text
  imageUrl    String?
  icon        String? // nombre de icono lucide
  position    Int     @default(0)
  active      Boolean @default(true)

  // A donde sale la comanda de esta categoria. Se define una vez por categoria
  // y cada producto puede desviarse (ver MenuProduct.station).
  station Station @default(COCINA)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   MenuProduct[]
  promotions Promotion[]

  @@index([active, position])
  @@map("menu_categories")
}

model MenuProduct {
  id         String       @id @default(cuid())
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name        String
  slug        String  @unique
  description String? @db.Text
  priceCents  Int
  imageUrl    String?

  available Boolean  @default(true)
  featured  Boolean  @default(false)
  position  Int      @default(0)
  tags      String[] @default([]) // ej: "vegano", "picante", "sin gluten"

  // Estacion propia, para los productos que no siguen a su categoria (un postre
  // helado que arma la barra, un cafe que sale de cocina). Vacio = la categoria.
  station Station?

  // Precio promocional. Es la unica fuente del descuento: la carta de la web y
  // el POS de los garzones leen lo mismo, asi que una promo publicada aparece
  // sola en la comanda sin que nadie la cargue dos veces.
  promoPriceCents Int?
  promoLabel      String? // "Happy hour", "2x1 jueves"
  promoStartsAt   DateTime?
  promoEndsAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  promotions Promotion[]

  @@index([categoryId, position])
  @@index([available, featured])
  @@map("menu_products")
}

// ---------------------------------------------------------------------------
// Galeria
// ---------------------------------------------------------------------------

model GalleryImage {
  id      String  @id @default(cuid())
  url     String
  alt     String
  caption String?

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  tag      String? // "ambiente", "shows", "cocina", "publico"
  width    Int?
  height   Int?
  position Int     @default(0)
  featured Boolean @default(false)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
  @@index([eventId])
  @@map("gallery_images")
}

// ---------------------------------------------------------------------------
// Biblioteca de medios (uploads del CMS)
// ---------------------------------------------------------------------------

model Media {
  id           String   @id @default(cuid())
  url          String   @unique
  filename     String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("media")
}

// ---------------------------------------------------------------------------
// BarzuCard — programa de fidelizacion
// ---------------------------------------------------------------------------

enum CardStatus {
  ACTIVE
  SUSPENDED
}

/// Estado del pago y la entrega de la tarjeta fisica.
enum CardPaymentStatus {
  PENDING // se registro pero todavia no pago
  REPORTED // el socio aviso que transfirio; falta confirmar
  PAID // pago confirmado; puede pasar a retirarla
  DELIVERED // ya retiro la tarjeta fisica en el local
}

model Member {
  id           String    @id @default(cuid())
  email        String    @unique
  fullName     String
  passwordHash String
  phone        String?
  birthDate    DateTime?
  acceptsNews  Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card    BarzuCard?
  ratings EventRating[]
  resets  PasswordReset[]
  emails  EmailLog[]

  /**
   * El ano del ultimo saludo de cumpleanos.
   * Evita el papelon de saludar dos veces: el envio corre todos los dias y sin
   * esta marca, un socio que cumple el 12 recibiria un correo el 12, el 13 y
   * todos los dias de la ventana. Guarda el ano y no la fecha porque la
   * pregunta que hay que responder es "¿ya lo saludamos ESTE ano?".
   */
  birthdayGreetedYear Int?

  @@map("members")
}

model BarzuCard {
  id       String @id @default(cuid())
  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Identificador numerico legible (16 digitos) impreso en la tarjeta
  cardNumber String @unique
  // Token opaco que viaja dentro del QR (rotable si la tarjeta se pierde)
  qrToken    String @unique

  status CardStatus @default(ACTIVE)

  issuedAt  DateTime  @default(now())
  printedAt DateTime? // fecha en que se imprimio la tarjeta fisica

  // Pago y entrega de la tarjeta fisica, que es OPCIONAL: el socio queda activo
  // y con todos los beneficios desde que se registra, gratis. Esto solo sigue
  // el estado de quien ademas quiso la tarjeta de plastico.
  paymentStatus    CardPaymentStatus @default(PENDING)
  paymentReference String? // numero de operacion o dato que deja el socio
  reportedAt       DateTime? // cuando el socio aviso la transferencia
  paidAt           DateTime? // cuando el local confirmo el pago
  deliveredAt      DateTime? // cuando el socio retiro la tarjeta

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions Redemption[]
  vouchers    PromotionVoucher[]
  payments    Payment[]
  sessions    TableSession[]

  @@index([status])
  @@index([paymentStatus])
  @@map("barzu_cards")
}

enum PromotionType {
  PERCENT_OFF // % de descuento
  AMOUNT_OFF // monto fijo de descuento
  TWO_FOR_ONE // 2x1: por cada dos unidades, la mas barata sale gratis
  FREE_ITEM // producto de cortesia
}

/**
 * Sobre que se aplica el beneficio.
 * Es lo que le faltaba al sistema anterior: una promocion era un texto y el
 * canje, un comprobante. Nadie sabia sobre que producto descontar, asi que el
 * descuento terminaba a mano —o no se aplicaba—. Con el alcance, el POS
 * resuelve solo cuanto descontar de la cuenta.
 */
enum PromotionScope {
  CUENTA // sobre todo lo consumido
  CATEGORIA // sobre una categoria de la carta ("cervezas")
  PRODUCTO // sobre un producto concreto ("Schop rubia 500cc")
}

model Promotion {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String        @db.Text
  terms       String?       @db.Text
  imageUrl    String?
  type        PromotionType @default(PERCENT_OFF)

  // Valor asociado al tipo: % para PERCENT_OFF, centesimos para AMOUNT_OFF.
  // TWO_FOR_ONE y FREE_ITEM no lo usan: el valor sale del precio del producto.
  value Int @default(0)

  // Sobre que aplica. PRODUCTO exige productId; CATEGORIA exige categoryId.
  scope PromotionScope @default(CUENTA)

  productId String?
  product   MenuProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  categoryId String?
  category   MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  startsAt DateTime  @default(now())
  endsAt   DateTime?

  active   Boolean @default(true)
  position Int     @default(0)

  // Reglas de canje
  maxPerCard        Int   @default(1) // 0 = ilimitado
  maxTotal          Int   @default(0) // 0 = sin tope global
  redeemedCount     Int   @default(0)
  availableWeekdays Int[] @default([]) // 0=domingo .. 6=sabado; vacio = todos

  /**
   * Promocion de cumpleanos.
   * Con `birthdayOnly` la promocion deja de estar disponible para todos y solo
   * la puede canjear quien esta de cumpleanos, dentro de `birthdayWindowDays`
   * dias alrededor de la fecha. La ventana existe porque nadie sale a celebrar
   * necesariamente el mismo dia: un cumpleanos de martes se festeja el viernes,
   * y una promocion que vence a medianoche del martes no la usa nadie.
   */
  birthdayOnly       Boolean @default(false)
  birthdayWindowDays Int     @default(7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions Redemption[]
  vouchers    PromotionVoucher[]

  @@index([active, position])
  @@index([productId])
  @@index([categoryId])
  @@map("promotions")
}

model Redemption {
  id String @id @default(cuid())

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  cardId String
  card   BarzuCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  staffUserId String?
  staffUser   User?   @relation("RedemptionStaff", fields: [staffUserId], references: [id], onDelete: SetNull)

  // Codigo corto mostrado al cliente como comprobante del canje
  receiptCode String @unique

  note String?

  /**
   * La cuenta sobre la que se aplico.
   * Vacio = canje fuera de mesa (la pantalla suelta de /staff/canjear). Con
   * mesa, el descuento entra en la cuenta y se recalcula solo mientras la mesa
   * siga abierta: si el producto de la promo se anula, deja de descontar.
   */
  sessionId String?
  session   TableSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /**
   * Comensal al que se le aplico. Vacio = a la cuenta compartida.
   */
  dinerId String?
  diner   Diner?  @relation(fields: [dinerId], references: [id], onDelete: SetNull)

  /**
   * Lo que descontó, congelado al cobrar. Mientras no se cobre se recalcula.
   */
  discountCents Int @default(0)

  /**
   * El garzon la quito antes de cobrar: no cuenta para los topes.
   */
  voidedAt DateTime?

  redeemedAt DateTime @default(now())

  // Presente cuando el canje nacio de un cupon elegido por el socio
  voucher PromotionVoucher?

  @@index([cardId, redeemedAt])
  @@index([promotionId])
  @@index([sessionId])
  @@map("redemptions")
}

enum VoucherStatus {
  PENDING // emitido, esperando que el equipo de sala lo valide
  REDEEMED // ya se aplico en el local
  EXPIRED // vencio sin usarse
  CANCELLED // el socio lo dio de baja
}

/**
 * Cupon de un descuento concreto, elegido por el socio desde su BarzuCard.
 * La tarjeta identifica a la persona; el cupon identifica que quiere canjear.
 * Separarlos evita que el equipo de sala tenga que adivinar la promocion: al
 * escanear el QR del cupon ya sabe cual es y solo confirma.
 */
model PromotionVoucher {
  id String @id @default(cuid())

  // Codigo corto y legible, por si hay que dictarlo en la barra
  code  String @unique
  // Token opaco que viaja dentro del QR del descuento
  token String @unique

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  cardId String
  card   BarzuCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  status    VoucherStatus @default(PENDING)
  // Vigencia corta: el cupon se pide estando en el local
  expiresAt DateTime

  redemptionId String?     @unique
  redemption   Redemption? @relation(fields: [redemptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId, status])
  @@index([promotionId])
  @@map("promotion_vouchers")
}

// ---------------------------------------------------------------------------
// Configuracion del sitio
// ---------------------------------------------------------------------------

model SiteSettings {
  id String @id @default("singleton")

  // Identidad
  barName    String  @default("BARZUO")
  tagline    String  @default("Restobar · Lounge & Club")
  logoUrl    String?
  logoAltUrl String?
  faviconUrl String?

  // Hero
  heroTitle             String  @default("BARZUO")
  heroSubtitle          String? @db.Text
  heroEyebrow           String? @default("EST. 2024")
  heroImageUrl          String?
  /// Variante vertical para telefonos. Sin ella, la horizontal se recorta a
  /// la franja central, que suele ser la parte mas oscura y peor encuadrada.
  heroImageMobileUrl    String?
  heroVideoUrl          String?
  heroCtaLabel          String? @default("Ver cartelera")
  heroCtaHref           String? @default("/eventos")
  heroCtaSecondaryLabel String? @default("Ver la carta")
  heroCtaSecondaryHref  String? @default("/carta")
  heroVideoPosterUrl    String? // primer fotograma mientras carga el video

  // Portada: cintillo animado (una palabra o frase por linea)
  marqueeText String? @db.Text

  // Portada: titulos de cada bloque. Vacio = se usa el texto por defecto.
  homeEventsEyebrow   String? @default("Cartelera")
  homeEventsTitle     String? @default("Lo que se viene")
  homeEventsLead      String? @db.Text
  homeMenuEyebrow     String? @default("La carta")
  homeMenuTitle       String? @default("Para acompanar la noche")
  homeMenuLead        String? @db.Text
  homeLoyaltyTitle    String? @default("Tu tarjeta de beneficios")
  homeGalleryEyebrow  String? @default("Galeria")
  homeGalleryTitle    String? @default("Noches que quedan")
  homeGalleryLead     String? @db.Text
  homeLocationEyebrow String? @default("Ubicacion")
  homeLocationTitle   String? @default("Te esperamos")

  // Nosotros
  aboutTitle             String? @default("Nuestra historia")
  aboutLead              String? @db.Text
  aboutBody              String? @db.Text
  aboutImageUrl          String?
  aboutSecondaryImageUrl String?

  // Contacto y ubicacion
  address     String  @default("Av. Italia 1348, Providencia")
  addressCity String  @default("Santiago, Chile")
  latitude    Float   @default(-33.4392)
  longitude   Float   @default(-70.6250)
  phone       String?
  whatsapp    String?
  email       String?

  /**
   * A quien le llega el aviso de un mensaje del formulario.
   * Varias direcciones separadas por coma. Vive en los ajustes y no en una
   * variable de entorno porque cambia mas seguido que el codigo: entra alguien
   * nuevo a atender las reservas y hay que poder agregarlo sin desplegar.
   */
  notifyEmails String?

  // Textos generales
  reservationsNote String? @db.Text
  footerNote       String? @db.Text

  // SEO global
  seoTitle          String  @default("BARZUO Restobar · Musica en vivo, tributos y cocteleria")
  seoDescription    String  @default("BARZUO Restobar en Santiago. Cartelera de shows en vivo, tributos, DJ y la mejor cocteleria de autor.") @db.Text
  seoImageUrl       String?
  seoKeywords       String?
  googleAnalyticsId String?

  // BarzuCard
  loyaltyEnabled     Boolean @default(true)
  loyaltyTitle       String  @default("BarzuCard")
  loyaltyDescription String? @db.Text
  loyaltyTerms       String? @db.Text

  /**
   * Karaoke abierto.
   * No es una preferencia del sitio sino el estado de esta noche: lo prende y
   * lo apaga el encargado desde /staff/karaoke, y de el depende que la pagina
   * del QR de las mesas acepte pedidos o avise que hoy no hay.
   */
  karaokeOpen Boolean @default(false)

  // Tarjeta fisica: se abona por transferencia y se retira en el local.
  cardPriceCents  Int     @default(550000)
  cardPaymentInfo String? @db.Text // datos de la transferencia
  cardPickupInfo  String? @db.Text // como y cuando se retira

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model SocialLink {
  id       String  @id @default(cuid())
  platform String // instagram | facebook | tiktok | whatsapp | youtube | spotify | x
  label    String
  url      String
  position Int     @default(0)
  active   Boolean @default(true)

  @@index([active, position])
  @@map("social_links")
}

model OpeningHour {
  id        String  @id @default(cuid())
  dayOfWeek Int     @unique // 0 = domingo .. 6 = sabado
  opensAt   String? // "19:00"
  closesAt  String? // "03:00"
  closed    Boolean @default(false)
  note      String?

  @@map("opening_hours")
}

/**
 * Un dia en que el local no abre al publico.
 * Lo tipico es un evento privado: un cumpleaños o una empresa arriendan el
 * local entero y esa noche no hay cartelera ni mesas para nadie mas. Tambien
 * sirve para vacaciones o un feriado.
 * Es aparte de `OpeningHour`, que dice como es una semana normal ("los lunes
 * cerramos"). Esto es la excepcion de una fecha concreta, y por eso se guarda
 * como dia suelto: `@db.Date` a proposito, sin hora, porque lo que se cierra
 * es el dia y no un rango horario.
 */
model ClosedDay {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date

  /**
   * Lo que se muestra al publico: "Evento privado", "Vacaciones".
   */
  reason String @default("Evento privado")

  /**
   * Detalle opcional para el propio local; no se publica.
   */
  note String?

  createdById String?
  createdBy   User?   @relation("ClosedDayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([date])
  @@map("closed_days")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  /**
   * Cuando se le respondio por ultima vez.
   * Se guarda aparte de las respuestas para poder ordenar y filtrar la bandeja
   * sin traerlas todas: lo que hay que ver de un vistazo es cuales quedan sin
   * contestar, que es distinto de cuales quedan sin leer. Un mensaje leido y no
   * respondido es justamente el que se pierde.
   */
  answeredAt DateTime?

  replies ContactReply[]

  @@index([read, createdAt])
  @@index([answeredAt])
  @@map("contact_messages")
}

/**
 * Una respuesta a un mensaje del formulario.
 * Se guarda el texto ademas de mandarlo. Sin esto, lo unico que queda de la
 * conversacion es un correo en la casilla de quien lo escribio, y el resto del
 * equipo no tiene forma de saber que ya se respondio ni que se prometio — que
 * es como se termina contestando dos veces cosas distintas al mismo cliente.
 */
model ContactReply {
  id String @id @default(cuid())

  messageId String
  message   ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  body String @db.Text

  /**
   * Quien respondio. Queda en null si despues se elimina su usuario.
   */
  sentById String?
  sentBy   User?   @relation("ContactReplyAuthor", fields: [sentById], references: [id], onDelete: SetNull)

  /**
   * Si el correo salio de verdad. Una respuesta que no llego no es una respuesta.
   */
  status EmailStatus @default(SENT)
  error  String?

  createdAt DateTime @default(now())

  @@index([messageId, createdAt])
  @@map("contact_replies")
}

// ---------------------------------------------------------------------------
// Correo
//
// El local manda correo por cuatro motivos distintos y conviene poder mirarlos
// por separado: un aviso interno que no llego es un cliente sin responder, y
// una campana que reboto en la mitad de las casillas es una lista que hay que
// limpiar.
// ---------------------------------------------------------------------------

enum EmailKind {
  CONTACTO // aviso interno: alguien escribio por la web
  BIENVENIDA // el socio se registro y recibe su tarjeta
  TARJETA // reenvio de la tarjeta a pedido del socio
  RECUPERAR // enlace para volver a entrar
  CUMPLEANOS // el saludo con su beneficio
  CAMPANA // email marketing
}

enum EmailStatus {
  SENT
  FAILED
}

/**
 * Lo que salio por correo, y como le fue.
 * Sin esto, "no me llego" no se puede responder: no hay forma de distinguir un
 * correo que nunca se intento de uno que el proveedor rechazo o de uno que
 * llego y se perdio en la bandeja de no deseados.
 */
model EmailLog {
  id String @id @default(cuid())

  to      String
  subject String
  kind    EmailKind
  status  EmailStatus @default(SENT)

  /**
   * El identificador que devuelve Resend, para rastrear el envio alla.
   */
  providerId String?
  error      String?

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([memberId])
  @@index([campaignId])
  @@index([status, createdAt])
  @@map("email_logs")
}

/**
 * Un enlace para volver a entrar.
 * Se guarda el hash del token y no el token: quien consiga leer la tabla no
 * puede entrar a ninguna cuenta con lo que hay ahi. El token en claro existe
 * una sola vez, dentro del correo que recibe el socio.
 */
model PasswordReset {
  id String @id @default(cuid())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([memberId])
  @@index([expiresAt])
  @@map("password_resets")
}

// ---------------------------------------------------------------------------
// Email marketing
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT // se esta escribiendo
  SENDING // saliendo por lotes
  SENT
  FAILED
}

enum CampaignAudience {
  /**
   * Socios que aceptaron recibir novedades. Es el unico legitimo para promociones.
   */
  SUSCRITOS
  /**
   * Todos los socios activos. Reservado para avisos de servicio.
   */
  TODOS
  /**
   * Solo para probar: se manda a las casillas de aviso del local.
   */
  PRUEBA
}

/**
 * Una campana de correo.
 * El HTML se guarda tal cual lo dejo el administrador, con sus imagenes y su
 * formato. Se guarda el contenido y no una plantilla con huecos porque una
 * campana es una pieza de un momento: si el mes que viene cambia la plantilla,
 * lo que se mando en marzo tiene que seguir siendo lo que se mando en marzo.
 */
model Campaign {
  id String @id @default(cuid())

  name      String // nombre interno, para encontrarla en la lista
  subject   String // el asunto que ve el socio
  preheader String? // la linea de vista previa de la bandeja

  /**
   * El cuerpo, en HTML, tal como lo escribio el administrador.
   */
  html String @db.Text

  status   CampaignStatus   @default(DRAFT)
  audience CampaignAudience @default(SUSCRITOS)

  /**
   * Cuantos se alcanzaron a mandar y a cuantos se apuntaba.
   */
  sentCount   Int @default(0)
  failedCount Int @default(0)
  totalCount  Int @default(0)

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  emails EmailLog[]

  @@index([status, createdAt])
  @@map("campaigns")
}

// ---------------------------------------------------------------------------
// POS — mesas, comandas y cobros
//
// El garzon abre una mesa, identifica a los comensales por como se ven
// ("polera azul"), les carga productos de la misma carta que publica la web y
// manda la comanda. Cada producto sale impreso donde corresponde: la cocina
// imprime lo suyo y la barra lo suyo.
//
// El cobro admite las dos formas que se dan en un bar: la mesa entera de una
// vez, o cada comensal por separado. Cerrar el consumo de alguien no cierra la
// mesa: puede seguir pidiendo y se le cobra de nuevo.
// ---------------------------------------------------------------------------

/**
 * A donde sale impresa la comanda de un producto.
 */
enum Station {
  BARRA // cervezas, tragos, jugos, bebidas
  COCINA // comida
}

/**
 * Una zona del salon: "Salon", "Terraza", "Barra".
 * Antes la zona era texto suelto en cada mesa, y eso alcanzaba para escribirla
 * pero no para usarla: "Terraza" y "terraza" eran dos zonas distintas, no
 * habia forma de ordenarlas y renombrar una obligaba a editar mesa por mesa.
 * Como entidad propia, el mapa de sala se puede partir en secciones y cada
 * garzon mira la suya.
 */
model PosZone {
  id    String  @id @default(cuid())
  name  String  @unique
  /**
   * Color con el que se pinta la seccion en el mapa. Es una de las claves de
   * `ZONE_COLORS` (lib/pos-style.ts), no un valor CSS: la paleta la define el
   * diseño, no quien carga las zonas.
   */
  color String?

  active   Boolean @default(true)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tables PosTable[]

  @@index([active, position])
  @@map("pos_zones")
}

model PosTable {
  id     String  @id @default(cuid())
  number Int     @unique // el numero con el que se la nombra en el local
  name   String? // "Terraza 2", cuando el numero no alcanza
  seats  Int     @default(4)

  zoneId String?
  zone   PosZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  active   Boolean @default(true)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions TableSession[]
  karaoke  KaraokeEntry[]

  @@index([active, position])
  @@index([zoneId])
  @@map("pos_tables")
}

enum TableSessionStatus {
  OPEN
  CLOSED
}

/**
 * Un turno de mesa: desde que se sientan hasta que se van.
 * Se mantiene OPEN mientras quede algo sin cobrar o el garzon no la cierre a
 * mano, aunque algunos comensales ya hayan pagado lo suyo.
 */
model TableSession {
  id      String   @id @default(cuid())
  tableId String
  table   PosTable @relation(fields: [tableId], references: [id], onDelete: Restrict)

  // Correlativo legible del turno, para nombrarlo en voz alta: "M4-0312".
  code   String             @unique
  status TableSessionStatus @default(OPEN)

  guests Int     @default(1)
  note   String?

  openedById String?
  openedBy   User?   @relation("SessionOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)

  /**
   * Quien atiende la mesa ahora.
   * Arranca siendo quien la abrio, pero no son lo mismo: la mesa cambia de
   * manos cuando entra el turno de la noche, cuando el que la abrio esta en la
   * caja, o cuando alguien cubre un descanso. Lo que hay que poder contestar
   * desde la sala es "quien esta atendiendo la 7", no "quien la abrio a las
   * nueve".
   */
  attendedById String?
  attendedBy   User?   @relation("SessionWaiter", fields: [attendedById], references: [id], onDelete: SetNull)

  /**
   * Etiqueta de la mesa: "Cumpleaños", "Reservada", "Sale a las 22".
   * Es lo que hoy se grita de una punta a la otra del salon. Escrita en la
   * casilla de la mesa la ve cualquiera que mire la sala, incluido el que
   * recien entra al turno.
   */
  tag      String?
  /**
   * Clave de color de la etiqueta (ver `TAG_COLORS` en lib/pos-style.ts).
   */
  tagColor String?

  /**
   * BarzuCard presentada en la mesa.
   * Es la llave de todo el programa: sin tarjeta en la mesa no se puede
   * aplicar ninguna promocion. Se pide una vez, al principio, y vale para toda
   * la noche —incluidos los cobros separados por comensal—.
   */
  cardId String?
  card   BarzuCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  openedAt DateTime  @default(now())
  closedAt DateTime?

  diners      Diner[]
  items       OrderItem[]
  tickets     OrderTicket[]
  payments    Payment[]
  redemptions Redemption[]

  @@index([status, openedAt])
  @@index([tableId, status])
  @@index([cardId])
  @@index([attendedById, status])
  @@map("pos_table_sessions")
}

/**
 * Un comensal dentro de la mesa, identificado por como se ve.
 * No se le pide el nombre a nadie: el garzon anota "polera azul" y con eso
 * reparte los pedidos y despues cobra por separado.
 */
model Diner {
  id        String       @id @default(cuid())
  sessionId String
  session   TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  label    String // "Polera azul", "Pelo largo", "El del cumpleanos"
  color    String? // color de la etiqueta en la pantalla del garzon
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       OrderItem[]
  payments    Payment[]
  redemptions Redemption[]

  @@index([sessionId, position])
  @@map("pos_diners")
}

enum OrderItemStatus {
  DRAFT // cargado por el garzon, todavia sin mandar
  SENT // ya salio en una comanda
  CANCELLED
}

/**
 * Una linea de la cuenta.
 * Guarda copia del nombre y del precio: la carta se edita todo el tiempo y una
 * cuenta abierta no puede cambiar de precio a mitad de la noche.
 */
model OrderItem {
  id        String       @id @default(cuid())
  sessionId String
  session   TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Sin comensal = va a la cuenta general de la mesa (para picoteo compartido).
  dinerId String?
  diner   Diner?  @relation(fields: [dinerId], references: [id], onDelete: SetNull)

  // Si el producto se borra de la carta, la linea sobrevive con su copia.
  productId String?
  product   MenuProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name           String
  unitPriceCents Int
  quantity       Int     @default(1)
  note           String? // "sin cebolla", "bien cocido"

  // Descuento ya resuelto al cargar la linea (promo vigente de la carta).
  // Los beneficios de BarzuCard NO se guardan aca: viven en Redemption y se
  // recalculan sobre la cuenta, para que quitar uno sea una sola operacion.
  discountCents Int     @default(0)
  discountLabel String?

  /**
   * Linea nacida de una cortesia de BarzuCard (FREE_ITEM).
   */
  courtesy Boolean @default(false)

  station Station
  status  OrderItemStatus @default(DRAFT)

  ticketId String?
  ticket   OrderTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  // Se llena al cobrar. Vacio = todavia se debe.
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("OrderItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, status])
  @@index([dinerId])
  @@index([paymentId])
  @@map("pos_order_items")
}

/**
 * Estado de IMPRESION de la comanda (ver `status`).
 */
enum TicketStatus {
  PENDING // en cola, esperando que la impresora la retire
  PRINTED
  FAILED
}

/**
 * Estado de PREPARACION de la comanda (ver `prep`).
 * Son solo dos, y no por simplificar: en cocina no hay manos limpias para
 * tocar una pantalla. La comanda esta pendiente hasta que alguien se la lleva,
 * y quien la cierra es el garzon que va a buscar el plato —desde su telefono,
 * que si maneja con las manos secas—. Los tres estados anteriores (nueva, en
 * curso, lista) obligaban a la cocina a tocar dos veces cada comanda con las
 * manos mojadas, y en la practica nadie los movia.
 * No tiene nada que ver con si el papel salio (ver `status`): un local puede
 * trabajar solo con pantallas, solo con impresoras, o con las dos.
 */
enum PrepStatus {
  PENDIENTE
  RETIRADA
}

/**
 * Que papel es.
 * COMANDA es lo que se prepara —sale hacia la barra o hacia la cocina— y se
 * mueve por las pantallas de esas estaciones. COBRO es el resumen de lo que
 * pago un cliente: sale por la impresora de caja y no lo prepara nadie, asi
 * que no aparece en ninguna pantalla de estacion.
 */
enum TicketKind {
  COMANDA
  COBRO
}

/**
 * Una comanda: lo que sale por una impresora.
 * Se guarda en la base y queda PENDING hasta que el agente de impresion del
 * local la retira. Asi un corte de red o una impresora sin papel no pierde el
 * pedido: queda en cola y se reimprime.
 */
model OrderTicket {
  id        String       @id @default(cuid())
  sessionId String
  session   TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Correlativo del dia, el numero que se canta: "comanda 42".
  number Int

  kind TicketKind @default(COMANDA)

  // Solo las comandas tienen estacion; el resumen de cobro no va a preparar
  // nadie, asi que va vacio.
  station Station?

  // Lleno solo en las de tipo COBRO: el pago que resume.
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  /**
   * El envio del que salio, cuando salio junto con otras.
   * Un toque de "enviar" en una mesa con tragos y comida crea dos comandas: una
   * de barra y una de cocina. Comparten este identificador para que el agente
   * de impresion sepa que son del mismo viaje del garzon.
   * Con una sola impresora eso le permite sacarlas en un unico papel continuo,
   * separadas por una linea de corte: la garzona retira una vez, lo parte en
   * dos y reparte. Con una impresora por estacion el agrupamiento no se aplica
   * —cada mitad tiene su propia ranura— y el campo simplemente no se usa.
   */
  batchId String?

  /**
   * Impresion: la cola que atiende el agente del local.
   */
  status    TicketStatus @default(PENDING)
  attempts  Int          @default(0)
  lastError String?
  printedAt DateTime?

  /**
   * Preparacion: lo que se ve en la pantalla de la estacion.
   */
  prep       PrepStatus @default(PENDIENTE)
  pickedUpAt DateTime?

  createdById String?
  createdBy   User?   @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([status, createdAt])
  @@index([kind, station, prep])
  @@index([sessionId])
  @@index([paymentId])
  @@index([batchId])
  @@map("pos_order_tickets")
}

enum PaymentMethod {
  EFECTIVO
  DEBITO
  CREDITO
  TRANSFERENCIA
  OTRO
}

/**
 * Un cobro.
 * Con comensal cobra solo lo suyo y la mesa sigue abierta; sin comensal cobra
 * todo lo que quede pendiente. Un mismo comensal puede tener varios cobros si
 * cerro, siguio tomando y volvio a cerrar.
 */
model Payment {
  id        String       @id @default(cuid())
  sessionId String
  session   TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Vacio = se cobro la mesa completa.
  dinerId String?
  diner   Diner?  @relation(fields: [dinerId], references: [id], onDelete: SetNull)

  code String @unique // comprobante que se le dice al cliente

  // Sin propina: la deja el cliente en la terminal de cobro, no el POS.
  subtotalCents Int
  discountCents Int @default(0)
  totalCents    Int

  method PaymentMethod @default(EFECTIVO)

  // BarzuCard presentada al pagar: es el momento natural para sumar puntos.
  cardId String?
  card   BarzuCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  cashierId String?
  cashier   User?   @relation("PaymentCashier", fields: [cashierId], references: [id], onDelete: SetNull)

  paidAt DateTime @default(now())

  items   OrderItem[]
  tickets OrderTicket[]

  @@index([sessionId])
  @@index([paidAt])
  @@index([cardId])
  @@map("pos_payments")
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action    String // "create" | "update" | "delete" | "login" | "redeem"
  entity    String // "Event" | "MenuProduct" | ...
  entityId  String?
  summary   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Karaoke
//
// Dos piezas: el catalogo de canciones que el local ya uso alguna vez y la
// cola de esta noche. El catalogo existe por una razon concreta: la API de
// YouTube da 10.000 unidades al dia y cada busqueda cuesta 100 —cien busquedas
// y se acabo—, asi que cada video que se encola queda guardado y la segunda
// vez que alguien pide la misma cancion no se gasta nada. Un karaoke repite
// mucho: a las pocas noches casi todo sale de aca.
// ---------------------------------------------------------------------------

/**
 * Una cancion ya vista, con su video de YouTube.
 */
model KaraokeTrack {
  id      String  @id @default(cuid())
  videoId String  @unique // el de YouTube: 11 caracteres
  title   String
  channel String?

  durationSeconds Int?
  thumbnailUrl    String?

  /// Titulo y canal en minusculas y sin tildes: es contra esto que busca la
  /// pagina de las mesas, que nunca llama a la API.
  search String

  timesQueued  Int       @default(0)
  lastQueuedAt DateTime?

  /// Se saca del buscador sin borrar el historial: la version con mala pista,
  /// la que resulto no ser karaoke, la que el local no quiere que suene.
  blocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries KaraokeEntry[]

  @@index([blocked, timesQueued])
  @@index([search])
  @@map("karaoke_tracks")
}

enum KaraokeEntryStatus {
  PEDIDA // la pidio una mesa por el QR; falta que sala la acepte
  EN_COLA
  CANTANDO
  CANTADA
  DESCARTADA
}

enum KaraokeSource {
  SALA // la cargo el encargado
  MESA // llego por el QR de la mesa
}

/**
 * Un turno en la cola.
 * Puede nacer sin video: quien pide desde la mesa busca en el catalogo del
 * local, y si su cancion no esta todavia, la escribe con palabras
 * (`requestText`). El encargado la busca en YouTube al aceptarla y recien ahi
 * queda enganchada a un `KaraokeTrack`.
 */
model KaraokeEntry {
  id String @id @default(cuid())

  trackId String?
  track   KaraokeTrack? @relation(fields: [trackId], references: [id], onDelete: SetNull)

  /// Lo que se pidio cuando todavia no hay video asignado.
  requestText String?

  /// Como se le llama por el microfono. No es el nombre legal de nadie.
  singer String

  tableId String?
  table   PosTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  status KaraokeEntryStatus @default(EN_COLA)
  source KaraokeSource      @default(SALA)

  /// Orden dentro de la cola. Menor canta antes.
  position Int     @default(0)
  note     String?

  queuedById String?
  queuedBy   User?   @relation("KaraokeQueuedBy", fields: [queuedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  startedAt DateTime?
  endedAt   DateTime?

  @@index([status, position])
  @@index([tableId, status])
  @@index([createdAt])
  @@map("karaoke_entries")
}

/**
 * Una busqueda que ya se le pago a YouTube.
 * Con las mesas buscando solas, la cuota de la API es el recurso escaso: son
 * cien busquedas al dia para todo el local. Cada vez que se paga una, los
 * videos quedan guardados como `KaraokeTrack` y la frase normalizada queda
 * aca; la proxima mesa que escriba lo mismo se sirve del catalogo sin gastar
 * nada. Un karaoke repite tanto que a las pocas noches casi todo sale de ahi.
 */
model KaraokeSearch {
  /// Lo que se escribio, normalizado igual que `KaraokeTrack.search`.
  key String @id

  /// Cuantas veces se pidio. Es el ranking real de lo que busca la gente.
  hits Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("karaoke_searches")
}
