# ============================================================================
# BARZUO - PC del local (Windows)
#
# Copia este archivo a "barzuo-local.env", en esta misma carpeta, y completa
# los valores. Lo leen "barzuo-inicio.ps1" y "instalar-inicio.ps1".
#
# Este archivo queda fuera de git: lleva el token de impresion.
# ============================================================================

# --- Sitio -------------------------------------------------------------------
# URL publica del sitio, sin barra final. Es la que abre el navegador y a la
# que le pregunta las comandas el agente de impresion.
BARZUO_URL=https://barzuo.cl

# --- Impresion ---------------------------------------------------------------
# El MISMO valor que tiene el servidor en PRINT_AGENT_TOKEN. Sin el, la cola
# de comandas queda cerrada y no sale ningun papel.
PRINT_AGENT_TOKEN=

# La impresora que recibe todo lo que no tenga una propia.
#   Por USB compartida en Windows:  \\localhost\POS80
#   De red:                         192.168.1.50  (puerto 9100 por defecto)
PRINTER_DEFAULT=\\localhost\POS80

# Opcionales, para cuando cada estacion tenga la suya.
# PRINTER_COCINA=
# PRINTER_BARRA=
# PRINTER_CAJA=

# Ancho del papel en caracteres: 48 = 80mm, 32 = 58mm.
# PRINT_WIDTH=48

# Con que se levanta el agente. Vacio, se busca solo: primero dentro del repo y
# despues en el escritorio, que es donde suele quedar.
#
# Admite el .mjs -y entonces la configuracion de impresion sale de este mismo
# archivo- o el .bat/.cmd/.ps1 que el equipo ya use, que se ejecuta tal cual y
# lleva sus propios valores adentro.
# AGENTE_RUTA=C:\Users\barzu\Desktop\print-agent.mjs
# AGENTE_RUTA=C:\Users\barzu\Desktop\agente.bat

# En "no", el arranque no toca el agente: se da por hecho que el equipo ya lo
# levanta por su cuenta y aca solo se abren las pantallas. En "si" -por
# defecto- lo levanta y lo repone si se cae, pero nunca duplica: si detecta uno
# corriendo, lo deja trabajar.
# AGENTE_LEVANTAR=si

# --- Pantallas ---------------------------------------------------------------
# Que abre cada monitor al encender el equipo. Cada uno se identifica por su
# indice, ordenados de izquierda a derecha: 0 es el de mas a la izquierda.
# "instalar-inicio.ps1 -Pantallas" los lista con su tamano y posicion.

# La pantalla tactil del mostrador: el POS de mesas.
PANTALLA_POS_INDICE=0
PANTALLA_POS_RUTA=/staff/pos

# El monitor del PC: las ventas del dia.
PANTALLA_CAJA_INDICE=1
PANTALLA_CAJA_RUTA=/admin/caja

# En "no", una pantalla que alguien cierre se queda cerrada. Por defecto se
# reabre a los diez segundos: en medio del servicio, un toque en el aspa no
# puede dejar a la sala sin POS. Mientras se configura el equipo estorba, y ahi
# se apaga.
# VIGILAR_PANTALLAS=si

# El teclado que dibuja la app, para la pantalla que no tiene ninguno.
#   1      lo dibuja siempre (la pantalla del mostrador)
#   0      nunca: se deja el del sistema
#   auto   lo decide la app segun el puntero, que es lo que hace por defecto
#
# Va aca y no una sola vez a mano porque esta ventana usa un perfil de
# navegador propio: lo que se forzo en el navegador de siempre no llega hasta
# aca. Una pantalla tactil sin mouse conectado se declara "dedo" y la app da
# por hecho que el sistema tiene teclado que ofrecer; en Windows, en modo
# kiosco, no lo tiene, y los campos quedan sin forma de escribir.
PANTALLA_POS_TECLADO=1

# Franja ciega del monitor tactil, en pixeles. Algunos monitores no registran
# el tacto en el borde superior; con esto las cabeceras de sala bajan lo justo.
# Se deja en 0 si el monitor responde bien en todo el borde.
PANTALLA_POS_ZONA_MUERTA=0

# Para dejar una sola pantalla, se borra el indice de la otra:
#   PANTALLA_CAJA_INDICE=
